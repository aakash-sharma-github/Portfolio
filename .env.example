# ── GitHub ────────────────────────────────────────────────────────────────────
GITHUB_USERNAME=<your_github_username>
GITHUB_TOKEN=<your_github_token>

# ── SMTP (Gmail) ──────────────────────────────────────────────────────────────
SMTP_EMAIL=<your_smtp_email>
SMTP_EMAIL_PASSWORD=<your_smtp_app_password>

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=<your_mongodb_connection_string>

# ── Redis (required for rate limiting & persistent cache in production) ────────
# Get a free instance at https://upstash.com  (Vercel KV also works)
REDIS_URL=<your_redis_url>

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=<your_cloudinary_cloud_name>
CLOUDINARY_API_KEY=<your_cloudinary_api_key>
CLOUDINARY_API_SECRET=<your_cloudinary_api_secret>
API_ENVIRONMENT_VARIABLE_CLOUDINARY_URL=<your_cloudinary_url>

# ── TinyMCE ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_TINYMCE=<your_tinymce_api_key>

# ── Admin auth ────────────────────────────────────────────────────────────────
# Generate hash:  node scripts/generatePassword.js your_password
ADMIN_PASSWORD_HASH=<your_bcrypt_hash_base64_encoded>
JWT_SECRET=<a_long_random_secret_min_32_chars>

# ── URLs ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000
# Set this to your live domain in production (used for OG meta tags)
NEXT_PUBLIC_SITE_URL=https://your-domain.com
